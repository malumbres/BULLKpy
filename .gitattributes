# Normalise line endings so files authored on different machines (including
# legacy CR-only Mac files) do not produce spurious diffs.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf

# Notebooks are JSON but are large and noisy; keep LF, no CRLF conversion.
*.ipynb text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.h5ad  binary
*.xlsx  binary
*.xls   binary
